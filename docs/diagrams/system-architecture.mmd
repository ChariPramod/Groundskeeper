flowchart TB
  accTitle: Groundskeeper system architecture and deployment state
  accDescr: The Vercel browser workspace currently uses demo fixtures. Its implemented live path authorizes installation-scoped queries and versioned audited writes to PostgreSQL. Separately hosted webhook ingress and leased workers analyze pinned GitHub snapshots without executing examples. Operator commands verify examples, publish approved draft repairs, and clean expired sessions. Live infrastructure remains pending.
  subgraph WEB["WEB APPLICATION · Vercel deployment"]
    direction LR
    Browser["Browser workspace<br/>Dashboard · inbox · operations<br/>Team access · page export"]
    Demo["Current public mode: demo<br/>Fixtures and local interactions"]
    Next["Implemented live routes<br/>OAuth · current role · installation<br/>Strict inputs · bounded responses"]
    Browser -->|"Demo selected"| Demo
    Browser -->|"Live configured"| Next
  end

  subgraph DATA["POSTGRESQL · live connection pending"]
    direction LR
    Reports[("Immutable evidence<br/>Analysis and verification reports<br/>Generated list summaries")]
    Team[("Team and review state<br/>Membership · hashed sessions<br/>Versions · actor-attributed events")]
    Queue[("Durable recovery records<br/>Deliveries · expiring leases<br/>Publication reservations")]
  end
  Next -->|"Lists · owned details · completion aggregate"| Reports
  Next <-->|"Current access; atomic state + audit"| Team
  Next -->|"Queue aggregates and bounded job list"| Queue

  subgraph PROCESSING["BACKGROUND ANALYSIS · separate hosting pending"]
    direction LR
    GitHub["GitHub App events"]
    Ingress["Probot webhook ingress<br/>Verify signature · persist first"]
    Worker["Supervised leased worker<br/>Pinned snapshot + blob checks"]
    Analysis["TypeScript claims parser<br/>Python change and impact analysis<br/>Lease-fenced report persistence<br/>No example execution"]
    GitHub --> Ingress
    Worker --> Analysis
  end
  Ingress -->|"Minimal routing metadata"| Queue
  Queue -->|"SKIP LOCKED · fenced lease"| Worker
  Analysis --> Reports
  Analysis -->|"Ack after save"| Queue

  subgraph EXPLICIT["EXPLICIT OPERATOR WORKFLOWS"]
    direction LR
    Verify["Verify or prepare repair<br/>Restricted Docker examples"]
    Artifacts["Immutable local artifacts<br/>Evidence · proposal · receipts"]
    Publish["Approved repair publisher<br/>Fresh verification + publication lease"]
    Draft["GitHub draft PR<br/>Human review"]
    Maintenance["Storage maintenance CLI<br/>Bounded expired-session batch<br/>Optional exact diagnostics"]
    Verify --> Artifacts --> Publish --> Draft
  end
  Reports -->|"Owned pinned analysis"| Verify
  Artifacts -->|"Persist verification; recover by import"| Reports
  Publish <-->|"Reserve and finalize"| Queue
  Maintenance -->|"Dry run by default; explicit apply"| Team

  classDef hosted fill:#eaf2ff,stroke:#2563eb,color:#162e55,stroke-width:1.5px;
  classDef pending fill:#fff7e6,stroke:#d49b22,color:#533d17,stroke-width:1.5px;
  classDef operator fill:#f0edff,stroke:#7962b3,color:#362753,stroke-width:1.5px;
  classDef external fill:#f1f5f9,stroke:#64748b,color:#243247,stroke-width:1.5px;
  class Browser,Demo,Next hosted;
  class Reports,Team,Queue,Ingress,Worker,Analysis pending;
  class Verify,Artifacts,Publish,Maintenance operator;
  class GitHub,Draft external;
