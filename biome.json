{
  "$schema": "https://biomejs.dev/schemas/2.5.13/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/.groundskeeper",
      "!**/*.generated.ts",
      "!**/*.schema.json",
      "!pnpm-lock.yaml",
      "!**/.next",
      "!**/.vercel",
      "!**/.venv",
      "!**/next-env.d.ts",
      "!**/test-results",
      "!**/playwright-report"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
