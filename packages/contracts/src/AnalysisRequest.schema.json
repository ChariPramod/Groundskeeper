{
  "$defs": {
    "Claim": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "page": {
          "minLength": 1,
          "title": "Page",
          "type": "string"
        },
        "anchor": {
          "title": "Anchor",
          "type": "string"
        },
        "kind": {
          "enum": [
            "paragraph",
            "code",
            "table_row",
            "image"
          ],
          "title": "Kind",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "position": {
          "$ref": "#/$defs/Position"
        },
        "references": {
          "items": {
            "$ref": "#/$defs/Reference"
          },
          "title": "References",
          "type": "array"
        },
        "language": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Language"
        },
        "runnable": {
          "default": false,
          "title": "Runnable",
          "type": "boolean"
        },
        "session": {
          "anyOf": [
            {
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Session"
        },
        "expected_output": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Output"
        },
        "status": {
          "$ref": "#/$defs/ClaimStatus",
          "default": "unknown"
        },
        "last_verified": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Verified"
        },
        "verification_method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Verification Method"
        }
      },
      "required": [
        "id",
        "page",
        "anchor",
        "kind",
        "text",
        "position"
      ],
      "title": "Claim",
      "type": "object"
    },
    "ClaimStatus": {
      "enum": [
        "unknown",
        "verified",
        "stale",
        "unverifiable"
      ],
      "title": "ClaimStatus",
      "type": "string"
    },
    "Position": {
      "additionalProperties": false,
      "properties": {
        "start_line": {
          "minimum": 1,
          "title": "Start Line",
          "type": "integer"
        },
        "start_column": {
          "minimum": 1,
          "title": "Start Column",
          "type": "integer"
        },
        "end_line": {
          "minimum": 1,
          "title": "End Line",
          "type": "integer"
        },
        "end_column": {
          "minimum": 1,
          "title": "End Column",
          "type": "integer"
        }
      },
      "required": [
        "start_line",
        "start_column",
        "end_line",
        "end_column"
      ],
      "title": "Position",
      "type": "object"
    },
    "Reference": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "identifier",
            "url",
            "path",
            "flag"
          ],
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "minLength": 1,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "title": "Reference",
      "type": "object"
    },
    "SourceFile": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "content": {
          "maxLength": 2000000,
          "title": "Content",
          "type": "string"
        }
      },
      "required": [
        "path",
        "content"
      ],
      "title": "SourceFile",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "claims": {
      "items": {
        "$ref": "#/$defs/Claim"
      },
      "maxItems": 10000,
      "title": "Claims",
      "type": "array"
    },
    "before": {
      "items": {
        "$ref": "#/$defs/SourceFile"
      },
      "maxItems": 2000,
      "title": "Before",
      "type": "array"
    },
    "after": {
      "items": {
        "$ref": "#/$defs/SourceFile"
      },
      "maxItems": 2000,
      "title": "After",
      "type": "array"
    }
  },
  "required": [
    "claims",
    "before",
    "after"
  ],
  "title": "AnalysisRequest",
  "type": "object"
}
