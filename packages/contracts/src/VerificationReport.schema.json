{
  "$defs": {
    "Claim": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "page": {
          "minLength": 1,
          "title": "Page",
          "type": "string"
        },
        "anchor": {
          "title": "Anchor",
          "type": "string"
        },
        "kind": {
          "enum": [
            "paragraph",
            "code",
            "table_row",
            "image"
          ],
          "title": "Kind",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "position": {
          "$ref": "#/$defs/Position"
        },
        "references": {
          "items": {
            "$ref": "#/$defs/Reference"
          },
          "title": "References",
          "type": "array"
        },
        "language": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Language"
        },
        "runnable": {
          "default": false,
          "title": "Runnable",
          "type": "boolean"
        },
        "session": {
          "anyOf": [
            {
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Session"
        },
        "expected_output": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Output"
        },
        "status": {
          "$ref": "#/$defs/ClaimStatus",
          "default": "unknown"
        },
        "last_verified": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Verified"
        },
        "verification_method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Verification Method"
        }
      },
      "required": [
        "id",
        "page",
        "anchor",
        "kind",
        "text",
        "position"
      ],
      "title": "Claim",
      "type": "object"
    },
    "ClaimStatus": {
      "enum": [
        "unknown",
        "verified",
        "stale",
        "unverifiable"
      ],
      "title": "ClaimStatus",
      "type": "string"
    },
    "Position": {
      "additionalProperties": false,
      "properties": {
        "start_line": {
          "minimum": 1,
          "title": "Start Line",
          "type": "integer"
        },
        "start_column": {
          "minimum": 1,
          "title": "Start Column",
          "type": "integer"
        },
        "end_line": {
          "minimum": 1,
          "title": "End Line",
          "type": "integer"
        },
        "end_column": {
          "minimum": 1,
          "title": "End Column",
          "type": "integer"
        }
      },
      "required": [
        "start_line",
        "start_column",
        "end_line",
        "end_column"
      ],
      "title": "Position",
      "type": "object"
    },
    "Reference": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "identifier",
            "url",
            "path",
            "flag"
          ],
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "minLength": 1,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "title": "Reference",
      "type": "object"
    },
    "SandboxLimits": {
      "additionalProperties": false,
      "properties": {
        "timeout_seconds": {
          "default": 10,
          "exclusiveMinimum": 0,
          "maximum": 60,
          "title": "Timeout Seconds",
          "type": "number"
        },
        "memory_mb": {
          "default": 128,
          "maximum": 512,
          "minimum": 64,
          "title": "Memory Mb",
          "type": "integer"
        },
        "output_bytes": {
          "default": 65536,
          "maximum": 1048576,
          "minimum": 256,
          "title": "Output Bytes",
          "type": "integer"
        },
        "max_blocks": {
          "default": 10,
          "maximum": 100,
          "minimum": 0,
          "title": "Max Blocks",
          "type": "integer"
        }
      },
      "title": "SandboxLimits",
      "type": "object"
    },
    "VerificationEvidence": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "claim_id": {
          "title": "Claim Id",
          "type": "string"
        },
        "claim_digest": {
          "title": "Claim Digest",
          "type": "string"
        },
        "source_digest": {
          "title": "Source Digest",
          "type": "string"
        },
        "method": {
          "const": "python_execution",
          "default": "python_execution",
          "title": "Method",
          "type": "string"
        },
        "outcome": {
          "enum": [
            "passed",
            "failed",
            "error",
            "skipped"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ClaimStatus"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "finished_at": {
          "format": "date-time",
          "title": "Finished At",
          "type": "string"
        },
        "image_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Image Id"
        },
        "exit_code": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exit Code"
        },
        "stdout": {
          "default": "",
          "title": "Stdout",
          "type": "string"
        },
        "stderr": {
          "default": "",
          "title": "Stderr",
          "type": "string"
        },
        "expected_output": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Output"
        },
        "limits": {
          "$ref": "#/$defs/SandboxLimits"
        }
      },
      "required": [
        "id",
        "claim_id",
        "claim_digest",
        "source_digest",
        "outcome",
        "status",
        "reason",
        "started_at",
        "finished_at",
        "limits"
      ],
      "title": "VerificationEvidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "source_digest": {
      "title": "Source Digest",
      "type": "string"
    },
    "image": {
      "title": "Image",
      "type": "string"
    },
    "claims": {
      "items": {
        "$ref": "#/$defs/Claim"
      },
      "title": "Claims",
      "type": "array"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/VerificationEvidence"
      },
      "title": "Evidence",
      "type": "array"
    },
    "outcomes": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Outcomes",
      "type": "object"
    },
    "statuses": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Statuses",
      "type": "object"
    }
  },
  "required": [
    "id",
    "created_at",
    "source_digest",
    "image",
    "claims",
    "evidence",
    "outcomes",
    "statuses"
  ],
  "title": "VerificationReport",
  "type": "object"
}
